# ===== 启衡精密 AI 财务提效 POC · 环境配置模板 =====
# 复制为 .env 后按实际环境修改：cp .env.example .env

# ---- ERP 开放平台 ----
# 宿主机直跑：http://localhost:8081
# Docker 容器内访问宿主机 ERP：http://host.docker.internal:8081
QIHENG_BASE_URL=http://localhost:8081

# M2+M3 业务 Key（最小权限：master-data:read, expense:read, expense:review,
# approval:read, attachment:read, invoice:read）
QIHENG_API_KEY=your_qiheng_api_key

# M4 银行对账专用 Key（最小权限：master-data:read, receivable:read）
QIHENG_M4_API_KEY=your_qiheng_m4_api_key

# ERP 门户（开发者中心创建 Key 用，一般无需修改）
QIHENG_PORTAL_URL=http://localhost:8080
QIHENG_PORTAL_USER=your_portal_user
QIHENG_PORTAL_PASSWORD=your_portal_password

# ---- OCR 引擎 ----
# paddle：本地 PaddleOCR（默认，发票图片不出域，推荐）
# qwen ：阿里云百炼千问 VL（需 DASHSCOPE_API_KEY，发票图片出域需申报）
OCR_ENGINE=paddle

# 云端 OCR 可选配置（OCR_ENGINE=qwen 时使用）
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3.6-flash

# AI 复核助手（默认开启）：LLM 用 OCR 结果+制度知识库独立复核，
# 与规则引擎意见不一致时转 FLAG 提请人工复核。开启后单据字段外发至模型服务商。
# LLM_REVIEW_ENABLED=1
LLM_REVIEW_API_KEY=your_llm_review_api_key
LLM_REVIEW_BASE_URL=https://api.deepseek.com/v1
LLM_REVIEW_MODEL=deepseek-v4-flash

# ---- LLM 并发与限流（M2 复核 / M3 巡检 / 调查 Agent 共用） ----
# 全局最大并发请求数；最小请求间隔（毫秒，0=不限速）。压测标定后调整。
LLM_MAX_CONCURRENCY=4
LLM_MIN_INTERVAL_MS=0

# ---- 2.0 新能力开关（默认关闭=现网行为不变） ----
# M2 编排管线：legacy=现行流水线；graph=LangGraph 工作流（含调查 Agent 与人工终审 interrupt）
M2_PIPELINE=legacy
# 分歧/FLAG 单调查 Agent（工具调用取证）
AGENT_INVESTIGATION_ENABLED=0
AGENT_MAX_STEPS=5
AGENT_TOKEN_BUDGET=30000
# 制度知识库检索：keyword=关键词（现状）；hybrid=本地向量+关键词融合（默认 bge-small-zh-v1.5）
RETRIEVAL_MODE=keyword
RERANK_ENABLED=0
# 模型加载禁止访问 huggingface.co（离线部署默认 1；在线下载新模型时显式设 0）
HF_HUB_OFFLINE=1

# ---- 数据路径（可选覆盖，默认使用仓库内目录） ----
# QIHENG_BANK_DIR=./bank
# QIHENG_SAMPLE_LABELS=./data/labels/public-sample-labels.json
