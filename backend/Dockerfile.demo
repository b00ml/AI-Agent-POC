# Lightweight public demo image: synthetic ERP adapter, no PaddleOCR model download.
FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt /app/backend/
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r /app/backend/requirements.txt -r /app/requirements.txt

COPY backend/app/ /app/backend/app/
COPY core/ /app/core/
COPY data/ /app/data/
COPY tools/ /app/tools/

RUN mkdir -p /app/output/reports /app/output/cache /app/output/runtime /app/output/artifacts

ENV PYTHONPATH=/app:/app/backend \
    DEMO_MODE=1 \
    QIHENG_BASE_URL=demo://local \
    QIHENG_BANK_DIR=/app/data/demo \
    OCR_ENGINE=fixture \
    LLM_REVIEW_ENABLED=0 \
    PYTHONIOENCODING=utf-8 \
    PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=2).read()"]

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
